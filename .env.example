# energycap configuration — copy to .env and fill in.
# .env is gitignored; NEVER commit real credentials. See PLAN.md §14.

# ---------------------------------------------------------------- AWS / storage
S3_BUCKET=my-energy-bucket
AWS_REGION=us-east-1
# Optional, and it MUST stay commented out unless you name a real profile.
# `AWS_PROFILE=` (empty) is not "no profile" to botocore -- it is a profile named
# empty string, and every AWS call then dies with
#   ProfileNotFound: The config profile () could not be found
# even when AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are perfectly good.
# `aws/s3io.py` now strips an empty one defensively; do not rely on that.
# AWS_PROFILE=some-named-profile
GLUE_DATABASE=energy
# Days the newest LG&E meter interval may age before /healthz reports the meter
# dataset stale. Generous on purpose: this is the UTILITY's publication lag, not
# ours, so it is REPORTED and never turns /healthz into a 503. A revoked
# authorisation is the loud case -- it fails the greenbutton_daily job.
METER_STALE_AFTER_DAYS=3

# ------------------------------------------------------------- Leviton (my.leviton.com)
LEVITON_USERNAME=you@example.com
LEVITON_PASSWORD=change-me

# --------------------------------------------------- Leviton ingestion (freshness)
# These knobs change how values are kept FRESH. They do not change how rows are
# SAMPLED: in every mode the 30s poll cycle emits exactly the same rows with one
# ts_utc per cycle, because the kWh math (mean_watts * sample_count *
# POLL_INTERVAL_S / 3.6e6) and sample_count-as-gap-detector both assume a fixed
# cadence. Nothing downstream — spool, uploader, compactor, rollup, Glue — changes.
#
# WHY the default is no longer plain REST: measured against the two live hubs
# (firmware 2.1.2), the REST endpoints serve a server-side cache. In a 12-minute
# probe, 10 of 12 channels never changed value once; one whole-panel feed held
# exactly 4086.05 W across 46 consecutive reads. An A/B probe showed the bandwidth
# keepalive makes no difference to a REST reader: the PUT lands (the hub's
# bandwidth field goes 0 -> 2) but both phases were identically frozen. The
# keepalive triggers a full state flood, and that flood is pushed over the
# WEBSOCKET — with no socket attached, nobody receives it. See DEVIATIONS.md.
#
#   hybrid  (default) WebSocket keeps an in-memory current-state store fresh; REST
#                     still does discovery and a periodic full re-read (reconcile).
#   ws                WebSocket for values; REST for discovery only, no reconcile.
#   rest              The original behaviour — every value read over REST each
#                     cycle, no socket. Fully supported; select it here if the
#                     socket ever misbehaves, no code change needed.
#
# Freshness is gated on the CONNECTION, never on how old a field is. While the
# socket is connected and the initial full state sync has completed, the store
# holds what the server currently believes; a steady load (a water-heater element
# sitting at 2462 W) legitimately does not update. While the socket is down, or
# before that first sync, we do not know the current value and emit NOTHING — the
# same gap a failed REST cycle leaves today. Expect sample_count to dip for hours
# in which the socket was reconnecting; that dip is honest.
LEVITON_INGEST=hybrid

# WebSocket endpoint. Here so a moved endpoint is a config edit, not a release.
LEVITON_WS_URL=wss://socket.cloud.leviton.com/

# Leviton hard-kills a WebSocket at exactly 60 minutes. Reconnect proactively well
# inside that so the changeover happens on our schedule rather than mid-cycle.
# Must be < 3600; 3300 = 55 minutes.
LEVITON_WS_RECONNECT_S=3300

# How long an OPEN socket may go silent before we treat it as dead and reconnect.
# Must be greater than POLL_INTERVAL_S: real loads are steady for minutes at a
# time, so a shorter window would call a stall during every quiet stretch and gap
# good data. Default 90s = 3 poll intervals.
LEVITON_WS_STALL_TIMEOUT_S=90

# How often to re-read full state over REST while the socket is up, as a
# cross-check against the WebSocket store (and the path that notices a field the
# socket never sends). 600s is the reference integration's own fallback-polling
# cadence. Used in `hybrid` only.
LEVITON_REST_RECONCILE_S=600

# ---------------------------------------------------- Bryant / Carrier Infinity cloud
CARRIER_USERNAME=you@example.com
CARRIER_PASSWORD=change-me
# System serial number == Bryant device_id (single system).
CARRIER_SERIAL=4022W200213

# ------------------------------------------------ LG&E Green Button Connect (ESPI)
# Issued by LG&E when the third-party registration is approved. The endpoints
# below are the real ones and are already the code defaults, so in practice only
# the four values marked "from the approval email" need setting.
#
# NEVER commit the secret or the registration access token. `.env` is gitignored;
# keep it that way.
#
# NO INLINE COMMENTS BELOW THIS LINE, and none anywhere in a real `.env`. These
# four used to carry a trailing "# from the approval email". python-dotenv strips
# that; Apple `container run --env-file` does NOT, and neither does Docker's
# --env-file. The client id would have been read as
# `gbc_xx                     # from the approval email` and the token exchange
# would have failed with an opaque 401. Comments go on their own line.

# From the approval email.
LGE_CLIENT_ID=gbc_xx
# From the approval email.
LGE_CLIENT_SECRET=change-me
# The registration management endpoint and its token can READ BACK AND ROTATE the
# client credentials. That makes the token more dangerous than the client secret —
# it is never used for data calls. Both come from the approval email.
LGE_REGISTRATION_CLIENT_URI=
LGE_REGISTRATION_ACCESS_TOKEN=change-me

# Defaults; override only if the custodian moves them.
LGE_AUTHORIZE_URL=https://mymeter.lge-ku.com/OAuthServer/authorize
LGE_TOKEN_URL=https://mymeter.lge-ku.com/OAuthServer/token
LGE_RESOURCE_URI=https://services.mymeter.co/resourceapi/238/GBC/espi/1_1/resource
LGE_BULK_URI=https://services.mymeter.co/resourceapi/238/GBC/espi/1_1/resource/Batch/Bulk/*
# Registered with LG&E as an EXACT string — a mismatch is a rejected authorization.
LGE_REDIRECT_URI=https://energycap.ericpullen.com/greenbutton/callback/
# Read back verbatim from LG&E's stored ApplicationInformation. No commas or spaces.
LGE_SCOPE=FB=1_3_4_5;IntervalDuration=900_3600;BlockDuration=Daily;HistoryLength=63072000;SubscriptionFrequency=Daily

# ------------------------------------------------------------------- Backfill only
# Read-only Scan of the legacy collector's table (PLAN.md §8). Not used at runtime.
DYNAMODB_TABLE=bryant-energy-data
# The old collector's JSON exports — source B of PLAN.md §8. A directory (scanned
# for energy_*.json) or a single file. Unset means ~/code/bryantDataCollector/energy_data,
# which only exists on the Mac: `energycap backfill` is run there, not in the container.
# BRYANT_LEGACY_JSON_PATH=~/code/bryantDataCollector/energy_data

# ------------------------------------------------------------------------ Runtime
# IANA zone used for ts_local, hour bucketing and LOCAL-date partitioning.
TZ_LOCAL=America/Kentucky/Louisville
# Poll intervals are clamped to a hard 30s floor in code regardless of these values.
POLL_INTERVAL_S=30
BRYANT_POLL_INTERVAL_S=30
# Re-discovery of hubs/breakers/CTs. Runs in every LEVITON_INGEST mode — the
# WebSocket subscribes per object, so it can only follow what discovery found.
LEVITON_DISCOVERY_INTERVAL_S=3600
# Mounted volume: spool.db, tokens/, status.json.
SPOOL_DIR=/data
SPOOL_RETENTION_DAYS=7
HEALTH_PORT=8080
LOG_LEVEL=INFO
# Which scheduled jobs this process runs. EMPTY MEANS ALL, which is PLAN.md
# section 5's one-container design and the right default for a single host.
# Set it to split the poller from the batch stages: a collector that omits
# rollup_hourly and daily_maintenance writes no derived data and can run under a
# narrower IAM policy (DEVIATIONS #181, #186). Comma-separated; an unknown name
# fails the boot rather than silently disabling a job. Valid names:
# upload_hourly, rollup_hourly, daily_maintenance, bryant_daily_energy,
# greenbutton_daily, digest_daily
# (digest_daily was missing from this list until 2026-08-24 while
# runtime.default_jobs registered it, so anyone who set SCHEDULED_JOBS by
# copying this comment silently lost the nightly digest. A test now pins this
# comment against default_jobs so the list cannot drift again.)
SCHEDULED_JOBS=

# --------------------------------------------------------------- Watchdog
# `energycap watch-health` reads a collector's /healthz and pushes what is wrong
# to Pushover. There is deliberately no default URL: a watcher that silently
# checked localhost would pass forever.
#
# WHERE TO RUN IT: on the collector's HOST, outside the container, pointed at the
# running container -- plus HEALTHCHECKS_PING_URL below. A watcher beside the
# collector cannot report that the collector's HOST died; the dead-man's switch
# can, and does it better than a second machine that might itself be asleep.
# See deploy/watchdog.md.
HEALTHZ_URL=http://energycap:8080/healthz
# Pushover. PUSHOVER_TOKEN is the APPLICATION/API token (create an application at
# pushover.net/apps/build); PUSHOVER_USER is your 30-character USER KEY, shown on
# the pushover.net dashboard. Both are secrets and are scrubbed from every log
# line. Leaving them empty does not disable the checks -- the command still runs
# and still exits nonzero -- it only means nothing is delivered, which is the
# failure mode this whole command exists to remove.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Dead-man's switch: a URL an external service (healthchecks.io, Better Uptime,
# Cronitor) gives you, which alarms when the pings STOP. watch-health pings it on
# every run it COMPLETES, whatever the verdict -- Pushover carries what is wrong
# with the collector, this carries the fact that the watcher is still there to
# say so. It is the only thing that can report the watcher's own death.
# Treated as a secret: anyone holding it can fake the heartbeat.
HEALTHCHECKS_PING_URL=
# An uploader silent this long means the archive stopped growing. It runs hourly
# at :05, so 7200s is one clean miss plus margin.
UPLOADER_STALE_AFTER_S=7200
# Spool rows awaiting upload before that is an alarm (~4 hours' backlog).
SPOOL_PENDING_CEILING=45000
# Consecutive failures of any one stage before it alarms. 2 keeps a single
# transient hourly miss quiet without hiding a real fault.
FAILURE_STREAK_ALARM=2

# ----------------------------------------------- Instrument integrity (check-channels)
# `energycap check-channels` asks whether the METERS can be trusted, which is a
# different question from whether the collector observed anything. A CT channel
# that returns the same wrong number for hours has full sample_count, no null,
# and a plausible value -- so every other check in this project passes while the
# data is wrong. That is DEVIATIONS #180, and it went six days undetected.
#
# Findings also ride the nightly `digest` push, so these thresholds decide what
# reaches a phone. Every default below is CALIBRATED against eight days of two
# real hubs -- one healthy, one faulty -- and each one separates them with zero
# false positives. Loosen them only against data, never against taste.
#
# Consecutive hours a channel may report min == max before it is a finding. One
# frozen hour is normal (a genuinely steady load overnight); the healthy hub did
# it twice in eight days and never twice in a row. The faulty hub produced runs
# of 2, 3 and 5 hours twelve times.
INTEGRITY_FROZEN_MIN_HOURS=2
# A panel's metered children cannot draw more than its feed -- everything passes
# through the feed clamp. Tolerance for that comparison, as a percent of the
# feed reading and as an absolute floor. Both matter: bare "any excess at all"
# fires 18 times on the HEALTHY hub from ordinary clamp tolerance (measured at
# ~3.4% against the utility meter), and an alert that cries wolf gets muted.
# 5%/100W fired 9 times on the faulty hub and 0 on the healthy one.
INTEGRITY_FEED_EXCESS_PCT=5.0
INTEGRITY_FEED_EXCESS_MIN_W=100.0
# Daily panel-vs-utility-meter disagreement that alarms. This is the ONLY check
# that catches a clamp reading live but scaled wrong -- a jaw not fully closed,
# or a clamp round the wrong conductor -- because such a channel varies, never
# freezes, and may stay above its children. Run it after touching any clamp.
# Measured clean days: -3.1%, -3.4%. Measured faulty hours: -12.5% to -22.2%.
INTEGRITY_METER_DISAGREE_PCT=10.0
# Hourly sample_count below this is SKIPPED and named, never counted as a pass.
# A half-watched hour has a narrow min..max for reasons that have nothing to do
# with the instrument.
INTEGRITY_MIN_SAMPLES=100

# ------------------------------------------------------- Semantic layer (build-dim)
# blackstart inventory; the build runs on the Mac, not necessarily in the container.
BLACKSTART_INVENTORY_PATH=/Users/epullen/code/blackstart/data/montfort.json
