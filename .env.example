# energycap configuration — copy to .env and fill in.
# .env is gitignored; NEVER commit real credentials. See PLAN.md §14.

# ---------------------------------------------------------------- AWS / storage
S3_BUCKET=my-energy-bucket
AWS_REGION=us-east-1
# Optional. Leave unset in the container if it uses keys / instance credentials.
AWS_PROFILE=
GLUE_DATABASE=energy

# ------------------------------------------------------------- Leviton (my.leviton.com)
LEVITON_USERNAME=you@example.com
LEVITON_PASSWORD=change-me

# --------------------------------------------------- Leviton ingestion (freshness)
# These knobs change how values are kept FRESH. They do not change how rows are
# SAMPLED: in every mode the 30s poll cycle emits exactly the same rows with one
# ts_utc per cycle, because the kWh math (mean_watts * sample_count *
# POLL_INTERVAL_S / 3.6e6) and sample_count-as-gap-detector both assume a fixed
# cadence. Nothing downstream — spool, uploader, compactor, rollup, Glue — changes.
#
# WHY the default is no longer plain REST: measured against the two live hubs
# (firmware 2.1.2), the REST endpoints serve a server-side cache. In a 12-minute
# probe, 10 of 12 channels never changed value once; one whole-panel feed held
# exactly 4086.05 W across 46 consecutive reads. An A/B probe showed the bandwidth
# keepalive makes no difference to a REST reader: the PUT lands (the hub's
# bandwidth field goes 0 -> 2) but both phases were identically frozen. The
# keepalive triggers a full state flood, and that flood is pushed over the
# WEBSOCKET — with no socket attached, nobody receives it. See DEVIATIONS.md.
#
#   hybrid  (default) WebSocket keeps an in-memory current-state store fresh; REST
#                     still does discovery and a periodic full re-read (reconcile).
#   ws                WebSocket for values; REST for discovery only, no reconcile.
#   rest              The original behaviour — every value read over REST each
#                     cycle, no socket. Fully supported; select it here if the
#                     socket ever misbehaves, no code change needed.
#
# Freshness is gated on the CONNECTION, never on how old a field is. While the
# socket is connected and the initial full state sync has completed, the store
# holds what the server currently believes; a steady load (a water-heater element
# sitting at 2462 W) legitimately does not update. While the socket is down, or
# before that first sync, we do not know the current value and emit NOTHING — the
# same gap a failed REST cycle leaves today. Expect sample_count to dip for hours
# in which the socket was reconnecting; that dip is honest.
LEVITON_INGEST=hybrid

# WebSocket endpoint. Here so a moved endpoint is a config edit, not a release.
LEVITON_WS_URL=wss://socket.cloud.leviton.com/

# Leviton hard-kills a WebSocket at exactly 60 minutes. Reconnect proactively well
# inside that so the changeover happens on our schedule rather than mid-cycle.
# Must be < 3600; 3300 = 55 minutes.
LEVITON_WS_RECONNECT_S=3300

# How long an OPEN socket may go silent before we treat it as dead and reconnect.
# Must be greater than POLL_INTERVAL_S: real loads are steady for minutes at a
# time, so a shorter window would call a stall during every quiet stretch and gap
# good data. Default 90s = 3 poll intervals.
LEVITON_WS_STALL_TIMEOUT_S=90

# How often to re-read full state over REST while the socket is up, as a
# cross-check against the WebSocket store (and the path that notices a field the
# socket never sends). 600s is the reference integration's own fallback-polling
# cadence. Used in `hybrid` only.
LEVITON_REST_RECONCILE_S=600

# ---------------------------------------------------- Bryant / Carrier Infinity cloud
CARRIER_USERNAME=you@example.com
CARRIER_PASSWORD=change-me
# System serial number == Bryant device_id (single system).
CARRIER_SERIAL=4022W200213

# ------------------------------------------------------------------- Backfill only
# Read-only Scan of the legacy collector's table (PLAN.md §8). Not used at runtime.
DYNAMODB_TABLE=bryant-energy-data
# The old collector's JSON exports — source B of PLAN.md §8. A directory (scanned
# for energy_*.json) or a single file. Unset means ~/code/bryantDataCollector/energy_data,
# which only exists on the Mac: `energycap backfill` is run there, not in the container.
# BRYANT_LEGACY_JSON_PATH=~/code/bryantDataCollector/energy_data

# ------------------------------------------------------------------------ Runtime
# IANA zone used for ts_local, hour bucketing and LOCAL-date partitioning.
TZ_LOCAL=America/Kentucky/Louisville
# Poll intervals are clamped to a hard 30s floor in code regardless of these values.
POLL_INTERVAL_S=30
BRYANT_POLL_INTERVAL_S=30
# Re-discovery of hubs/breakers/CTs. Runs in every LEVITON_INGEST mode — the
# WebSocket subscribes per object, so it can only follow what discovery found.
LEVITON_DISCOVERY_INTERVAL_S=3600
# Mounted volume: spool.db, tokens/, status.json.
SPOOL_DIR=/data
SPOOL_RETENTION_DAYS=7
HEALTH_PORT=8080
LOG_LEVEL=INFO

# ------------------------------------------------------- Semantic layer (build-dim)
# blackstart inventory; the build runs on the Mac, not necessarily in the container.
BLACKSTART_INVENTORY_PATH=/Users/epullen/code/blackstart/data/montfort.json
